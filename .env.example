# Copiar a ".env" y completar. El archivo .env NO se sube al repositorio.

# Clave para firmar los JWT (cadena larga y aleatoria, mínimo 32 caracteres)
JWT_SECRET=cambiar-por-una-clave-larga-y-aleatoria-de-32-o-mas-caracteres

# Usuario y contraseña con los que el backend y la Pico W entran a Mosquitto
MQTT_USER=arena
MQTT_PASSWORD=cambiar

# Correo (en desarrollo, docker-compose.dev.yml lo reemplaza por MailHog)
SMTP_HOST=smtp.ejemplo.com
SMTP_PORT=587
SMTP_USER=usuario
SMTP_PASSWORD=cambiar
SMTP_FROM=no-reply@control-del-reactor.local

# URL que llevan los enlaces de verificación y recuperación (IP o dominio del servidor)
PUBLIC_BASE_URL=http://localhost:8080
