# ============================================================
# Control del Reactor - .gitattributes (raíz del repositorio)
# ============================================================
# Git normaliza los finales de línea: se guardan con LF en el repositorio
# y en Windows se convierten solos al editar. Esto elimina los avisos
# "LF will be replaced by CRLF".
* text=auto
# Archivos que SIEMPRE deben usar LF (los ejecuta Linux: Docker y los agentes del pipeline)
*.sh          text eol=lf
Dockerfile    text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.conf        text eol=lf
*.py          text eol=lf
.env.example  text eol=lf
# Código y proyectos de .NET
*.cs          text diff=csharp
*.csproj      text
*.slnx        text
*.json        text
*.md          text
# ---------- Unity: escenas, prefabs y materiales son YAML ----------
# Para que Git los trate como texto (se pueden comparar y fusionar).
cliente-Unity/**/*.unity       text eol=lf
cliente-Unity/**/*.prefab      text eol=lf
cliente-Unity/**/*.mat         text eol=lf
cliente-Unity/**/*.anim        text eol=lf
cliente-Unity/**/*.controller  text eol=lf
cliente-Unity/**/*.asset       text eol=lf
cliente-Unity/**/*.meta        text eol=lf
# ---------- Unity: archivos binarios pesados con Git LFS ----------
# Requiere ejecutar UNA vez por computadora:  git lfs install
cliente-Unity/**/*.png filter=lfs diff=lfs merge=lfs -text
cliente-Unity/**/*.jpg filter=lfs diff=lfs merge=lfs -text
cliente-Unity/**/*.psd filter=lfs diff=lfs merge=lfs -text
cliente-Unity/**/*.fbx   filter=lfs diff=lfs merge=lfs -text
cliente-Unity/**/*.blend filter=lfs diff=lfs merge=lfs -text
cliente-Unity/**/*.wav filter=lfs diff=lfs merge=lfs -text
cliente-Unity/**/*.mp3 filter=lfs diff=lfs merge=lfs -text
cliente-Unity/**/*.ogg filter=lfs diff=lfs merge=lfs -text
cliente-Unity/**/*.mp4   filter=lfs diff=lfs merge=lfs -text
cliente-Unity/**/*.ttf filter=lfs diff=lfs merge=lfs -text
cliente-Unity/**/*.otf filter=lfs diff=lfs merge=lfs -text
